        </dependency>
        <dependency>
            <groupId>com.jnks.iot.common</groupId>
            <artifactId>proto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jnks.iot.common</groupId>
            <artifactId>data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jnks.iot.common</groupId>
