# Apache Kafka 官方镜像的配置（KRaft 单节点：broker 与 controller 合一，不再需要 zookeeper）。
#
# 上游仓库用的是 bitnami/kafka 的 KAFKA_CFG_* 变量 + zookeeper 模式；这里换成官方 apache/kafka，
# 变量名相应换成 KAFKA_*（官方镜像会把 KAFKA_ 前缀的变量映射成 server.properties 里的键）。
# 换镜像的原因：bitnami 在部分镜像加速站的白名单里被拦（`denied`），拉不下来；官方镜像可以。
#
# TB 侧不受影响 —— kafka-client.env 里还是连 kafka:9092。
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9094
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9094
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# Kafka 自身也是 JVM：不设堆上限默认会吃 VM 内存的 1/4（8G 的 VM 就是 2G），把整栈挤爆。
KAFKA_HEAP_OPTS=-Xmx512M -Xms256M

# 与上游 bitnami 版的取值保持一致
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_RETENTION_BYTES=1073741824
KAFKA_LOG_SEGMENT_BYTES=268435456
KAFKA_LOG_RETENTION_MS=300000
KAFKA_LOG_CLEANUP_POLICY=delete
