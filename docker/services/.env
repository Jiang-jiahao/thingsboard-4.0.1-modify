# compose 项目名。显式指定，避免随目录名变化 —— 改名会让 compose 认不出已有容器/卷。
COMPOSE_PROJECT_NAME=docker

TB_QUEUE_TYPE=kafka

# redis or redis-cluster or redis-sentinel
CACHE=redis

DOCKER_REPO=thingsboard

JS_EXECUTOR_DOCKER_NAME=tb-js-executor
TB_CORE_DOCKER_NAME=tb-core
TB_RULE_ENGINE_DOCKER_NAME=tb-rule-engine
WEB_UI_DOCKER_NAME=tb-web-ui
MQTT_TRANSPORT_DOCKER_NAME=tb-mqtt-transport
HTTP_TRANSPORT_DOCKER_NAME=tb-http-transport
COAP_TRANSPORT_DOCKER_NAME=tb-coap-transport
LWM2M_TRANSPORT_DOCKER_NAME=tb-lwm2m-transport
SNMP_TRANSPORT_DOCKER_NAME=tb-snmp-transport
TCP_TRANSPORT_DOCKER_NAME=tb-tcp-transport
UDP_TRANSPORT_DOCKER_NAME=tb-udp-transport
TB_VC_EXECUTOR_DOCKER_NAME=tb-vc-executor
EDQS_DOCKER_NAME=tb-edqs
EDQS_ENABLED=false

TB_VERSION=latest

# Database used by ThingsBoard, can be either postgres (PostgreSQL) or hybrid (PostgreSQL for entities database and Cassandra for timeseries database).
# According to the database type corresponding docker service will be deployed (see docker-compose.postgres.yml, docker-compose.hybrid.yml for details).

DATABASE=postgres

LOAD_BALANCER_NAME=tb-gateway

# 统一入口网关（nginx）：80/443 路由 + TLS、1883 MQTT、5683/5684 TCP/UDP，全部入口一个容器。
# 配置在 docker/nginx/config/，证书放 docker/nginx/certs/（首次用 docker/nginx/gen-self-signed-cert.sh
# 生成自签；生产换成真实证书或接 certbot）。
# 它替代了原来的两个代理：haproxy-certbot（80/443/1883 + 自动证书）与 nginx-tcpudp（5683/5684）。
NGINX_GATEWAY_IMAGE=nginx:1.27-alpine

# If enabled Prometheus and Grafana containers are deployed along with other containers
MONITORING_ENABLED=false

# Limit memory usage for each Java application
# Docker VM 默认只分到宿主一半内存（本机 16G → 约 8G），而栈里有 4 个 tb 服务（2 core + 2 rule-engine）
# + 8 个 transport + Kafka（也是 JVM）要同时跑，所以必须给每个 JVM 设堆上限；
# 不设的话每个默认可吃到 VM 内存的 1/4，几个进程就把 VM 撑爆（实测内核会直接 OOM kill）。
# 实测配额（8G 的 VM）：core/rule-engine 768M ×4 + transport 256M ×8 + Kafka 512M ≈ 6.8G，留出余量。
# transport 的堆在 docker-compose.yml 里用 JAVA_OPTS_TRANSPORT 覆盖，这里改 core/rule-engine。
JAVA_OPTS="-Xmx768M -Xms256M"
JAVA_OPTS_TRANSPORT="-Xmx256M -Xms128M"
