# JnksIOT server configuration

ZOOKEEPER_ENABLED=true
ZOOKEEPER_URL=zookeeper:2181
JS_EVALUATOR=remote
TRANSPORT_TYPE=remote

HTTP_LOG_CONTROLLER_ERROR_STACK_TRACE=false

# 前端部署前缀，与 ui/package.json 的 --base-href /jnks-iot/ 保持一致。
# 激活 / 重置密码等页面跳转由此补前缀，否则会跳到根路径而被宿主 nginx 返回 404。
UI_BASE_PATH=/jnks-iot

METRICS_ENABLED=true
METRICS_ENDPOINTS_EXPOSE=prometheus
