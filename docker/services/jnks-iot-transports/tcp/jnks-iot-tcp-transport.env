ZOOKEEPER_ENABLED=true
ZOOKEEPER_URL=zookeeper:2181

# 管理/指标用的 HTTP 端口
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_BIND_PORT=8087
HTTP_REQUEST_TIMEOUT=60000

# 共享监听端口：所有实例监听同一端口，多实例由入口网关（nginx）转发
TCP_BIND_ADDRESS=0.0.0.0
TCP_BIND_PORT=5683

# 严格模式：入口网关把真实设备地址写在每条连接开头的 PROXY protocol 头里，transport 从中解析
# （源 IP 认领 / sourceHost 校验都依赖它）。必须与 nginx.conf 的 proxy_protocol 同时开/关；
# 开启后 transport 只接受来自网关的连接，直连会被当成坏帧关闭。
TCP_SERVER_PROXY_PROTOCOL_ENABLED=true

METRICS_ENABLED=true
METRICS_ENDPOINTS_EXPOSE=prometheus
