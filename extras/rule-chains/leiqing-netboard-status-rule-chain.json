          "configuration": {
            "scriptLang": "JS",
            "jsScript": "var devId = null;\nif (msg['ss_deviceId'] != null) { devId = msg['ss_deviceId']; }\nelse if (metadata['ss_deviceId'] != null) { devId = metadata['ss_deviceId']; }\nif (devId == null) { devId = metadata.deviceName; }\nfunction pick2(k) {\n  var v = msg[k]; if (v != null) { return v; }\n  v = msg['cs_' + k]; if (v != null) { return v; }\n  v = metadata[k]; if (v != null) { return v; }\n  v = metadata['cs_' + k]; if (v != null) { return v; }\n  return null;\n}\nvar pa = pick2('paOn');\nvar lat = pick2('deviceLatitude');\nvar lon = pick2('deviceLongitude');\nvar body = {\n  deviceId: devId,\n  deviceStatus: 1,\n  jammingState: (pa === 1 || pa === '1') ? 1 : 0,\n  gpsLong: lon == null ? null : Number(lon),\n  gpsLat: lat == null ? null : Number(lat)\n};\nreturn { msg: body, metadata: metadata, msgType: msgType };\n"
