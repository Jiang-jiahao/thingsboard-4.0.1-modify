          "createdTime": 1794274862271,
          "ruleChainId": null,
          "type": "com.jnks.iot.rule.engine.transform.JnksIotTransformMsgNode",
          "name": "解析雷擎状态文本",
          "debugSettings": null,
          "singletonMode": false,
          "queueName": null,
          "configurationVersion": 0,
          "externalId": null,
          "configuration": {
            "scriptLang": "JS",
            "jsScript": "\nvar raw = msg.rawText != null ? String(msg.rawText) : (msg.payload != null ? String(msg.payload) : '');\nvar out = {};\nfunction num(v) { if (v === null || v === undefined || v === '') return null; var n = Number(v); return isNaN(n) ? null : n; }\nfunction set(k, v) { if (v !== null && v !== undefined && v !== '') { out[k] = v; } }\n\n// $VISSAT 合成状态行\nvar vi = raw.indexOf('$VISSAT');\nif (vi >= 0) {\n  var s = raw.substring(vi);\n  var se = s.indexOf('*#'); if (se >= 0) { s = s.substring(0, se); }\n  var colon = s.indexOf(':');\n  var body = colon >= 0 ? s.substring(colon + 1) : '';\n  var parts = body.split(';');\n  for (var i = 0; i < parts.length; i++) {\n    var kv = parts[i].split(',');\n    var k = kv[0];\n    if (k === 'GPS') { set('gpsSat', num(kv[1])); set('gpsSim', num(kv[2])); }\n    else if (k === 'GLO') { set('gloSat', num(kv[1])); set('gloSim', num(kv[2])); }\n    else if (k === 'BDS') { set('bdsSat', num(kv[1])); set('bdsSim', num(kv[2])); }\n    else if (k === 'RUNCNT') { set('runCount', num(kv[1])); }\n    else if (k === 'LNA') { set('paOn', num(kv[1])); }\n    else if (k === 'MODE') { set('workMode', num(kv[1])); }\n    else if (k === 'vel') { set('velocity', num(kv[1])); }\n    else if (k === 'angle') { set('lineAngle', num(kv[1])); }\n    else if (k === 'atten') { set('attenuation', num(kv[1])); }\n    else if (k === 'fixDelay') { set('fixDelay', num(kv[1])); }\n    else if (k === 'Radius') { set('radius', num(kv[1])); }\n  }\n}\nif (raw.indexOf('LNA,1') >= 0) { out.paOn = 1; }\nelse if (raw.indexOf('LNA,0') >= 0) { out.paOn = 0; }\n\n// $D 1Hz 状态帧（严格匹配 $D + 2 位长度 + 17 位数据，避免误匹配 $DEVPOS）\nvar dm = raw.match(/\\$D\\d\\d[0-9]{17}/);\nif (dm) {\n  var ds = dm[0];\n  set('systemStarted', num(ds.charAt(4)));\n  set('satSearchState', num(ds.charAt(5)));\n  set('satSearchResult', num(ds.charAt(6)));\n  set('paOn', num(ds.charAt(7)));\n  set('dirEast', num(ds.charAt(8)));\n  set('dirSoutheast', num(ds.charAt(9)));\n  set('dirSouth', num(ds.charAt(10)));\n  set('dirSouthwest', num(ds.charAt(11)));\n  set('dirWest', num(ds.charAt(12)));\n  set('dirNorthwest', num(ds.charAt(13)));\n  set('dirNorth', num(ds.charAt(14)));\n  set('dirNortheast', num(ds.charAt(15)));\n  set('driveMode', num(ds.charAt(16)));\n  set('power12v', num(ds.charAt(17)));\n  if (out.systemStarted != null) { out.powerOn = out.systemStarted; }\n}\n\n// $A06status 查询回复：第 12 个字符 0/1 表示下电/上电\nvar ai = raw.indexOf('$A06');\nif (ai >= 0 && raw.length > ai + 11) {\n  var c = raw.charAt(ai + 11);\n  if (c === '0' || c === '1') { out.powerOn = Number(c); }\n}\n\n// $DEVPOS:纬度,经度,高度\nvar pi = raw.indexOf('$DEVPOS:');\nif (pi >= 0) {\n  var ps = raw.substring(pi + 8);\n  var pe = ps.indexOf('*'); if (pe >= 0) { ps = ps.substring(0, pe); }\n  var pv = ps.split(',');\n  set('deviceLatitude', num(pv[0]));\n  set('deviceLongitude', num(pv[1]));\n  set('deviceHeight', num(pv[2]));\n}\n\n// 定位完成：GPS>=6 且 GLO>=4\nif (out.gpsSat != null && out.gloSat != null) {\n  out.locationReady = (out.gpsSat >= 6 && out.gloSat >= 4) ? 1 : 0;\n}\n\n// 直线驱离方向名称\nif (out.driveMode === 1) {\n  var names = ['东', '东南', '南', '西南', '西', '西北', '北', '东北'];\n  var keys = ['dirEast', 'dirSoutheast', 'dirSouth', 'dirSouthwest', 'dirWest', 'dirNorthwest', 'dirNorth', 'dirNortheast'];\n  var found = null;\n  for (var j = 0; j < keys.length; j++) {\n    if (out[keys[j]] === 1) { found = names[j]; break; }\n  }\n  out.signalDirection = found != null ? found : '关闭';\n}\nvar hasOut = false;\nfor (var kk in out) { hasOut = true; break; }\nif (!hasOut) { return { msg: msg, metadata: metadata, msgType: msgType }; }\nreturn { msg: out, metadata: metadata, msgType: msgType };\n"
          },
