          "type": "com.jnks.iot.rule.engine.transform.JnksIotTransformMsgNode",
          "name": "解析 system（属性 key=防区号）",
          "debugSettings": {
            "failuresEnabled": false,
            "allEnabled": false,
            "allEnabledUntil": 0
          },
          "singletonMode": false,
          "queueName": null,
          "configurationVersion": 0,
          "externalId": null,
          "configuration": {
            "scriptLang": "JS",
            "jsScript": "// /api/system：设备信息 -> 一条属性，key 为防区号（如 100303），value 为设备信息 JSON\nvar topic = metadata.mqttTopic || '';\nvar tp = topic.split('/');\nvar zone = (tp.length >= 3 && tp[2]) ? tp[2] : '';\n// 拿不到来源 topic 时退回固定 key，避免报文丢失\nvar key = zone || 'stationId';\n\nfunction asObj(v) {\n  if (v == null) { return null; }\n  if (typeof v === 'string') {\n    try { return JSON.parse(v); } catch (e) { return null; }\n  }\n  return v;\n}\n\nvar sys = asObj(msg.terjinSystem);\nif (sys == null) { sys = asObj(msg); }\n\nvar out = {};\nif (sys != null && sys.Devices != null && sys.Devices.length > 0) {\n  var byId = {};\n  var ids = [];\n  var online = 0;\n  var lastTs = 0;\n  for (var i = 0; i < sys.Devices.length; i++) {\n    var d = sys.Devices[i];\n    if (d.DeviceId != null) { byId[d.DeviceId] = d; ids.push(d.DeviceId); }\n    if (d.Online) { online++; }\n    if ((d.LastReport || 0) > lastTs) { lastTs = d.LastReport || 0; }\n  }\n  out[key] = JSON.stringify({\n    devices: byId,\n    deviceIds: ids,\n    deviceCount: sys.Devices.length,\n    onlineCount: online,\n    totalDevice: sys.TotalDevice,\n    onlineDevice: sys.OnlineDevice,\n    lastReportMs: lastTs ? lastTs * 1000 : null\n  });\n}\n\nreturn {msg: out, metadata: metadata, msgType: msgType};"
          },
