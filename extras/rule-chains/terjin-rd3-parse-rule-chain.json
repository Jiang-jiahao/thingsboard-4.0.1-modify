            "id": "2445a370-d27b-11f1-9a8d-3b1a29b0a61e"
          },
          "type": "com.jnks.iot.rule.engine.transform.JnksIotTransformMsgNode",
          "name": "解析 locate/detect（防区前缀遥测）",
          "debugSettings": {
            "failuresEnabled": false,
            "allEnabled": false,
            "allEnabledUntil": 0
          },
          "singletonMode": false,
          "queueName": null,
          "configurationVersion": 0,
          "externalId": null,
          "configuration": {
            "scriptLang": "JS",
            "jsScript": "var out = {};\n\n// 来源 topic：server/chan/{防区}/api/xxx\nvar topic = metadata.mqttTopic || '';\nvar tp = topic.split('/');\nvar zone = (tp.length >= 3 && tp[2]) ? tp[2] : '';\nvar p = zone ? (zone + '_') : '';\n\nfunction asObj(v) {\n  if (v == null) { return null; }\n  if (typeof v === 'string') {\n    try { return JSON.parse(v); } catch (e) { return null; }\n  }\n  return v;\n}\n\nvar loc = asObj(msg.terjinLocate);\nvar det = asObj(msg.terjinDetect);\nvar rid = asObj(msg.terjinRid);\n\n// ---- /api/locate 与 /api/rid：无人机定位（结构相同）----\nvar pos = null;\nvar src = null;\nif (loc != null && loc.DronePos != null) { pos = loc; src = 'locate'; }\nelse if (rid != null && rid.DronePos != null) { pos = rid; src = 'rid'; }\nif (pos != null) {\n  var kids = [];\n  for (var k in pos.DronePos) { if (pos.DronePos.hasOwnProperty(k)) { kids.push(k); } }\n  out[p + 'uavCount'] = kids.length;\n  out[p + 'uavSource'] = src;\n  var best = null, bestK = null;\n  for (var j = 0; j < kids.length; j++) {\n    var q = pos.DronePos[kids[j]];\n    if (best == null || (q.tsp || 0) > (best.tsp || 0)) { best = q; bestK = kids[j]; }\n  }\n  if (best != null) {\n    out[p + 'uavId'] = best.uavId != null ? best.uavId : bestK;\n    out[p + 'uavLon'] = best.uavLon;\n    out[p + 'uavLat'] = best.uavLat;\n    out[p + 'uavAlt'] = best.uavAlt;\n    out[p + 'uavHeight'] = best.uavHeight;\n    out[p + 'velocity'] = best.velocity;\n    out[p + 'yaw'] = best.yaw;\n    out[p + 'frequencyHz'] = best.frequency;\n    out[p + 'bandHz'] = best.band;\n    out[p + 'uavModel'] = best.uavModel;\n    out[p + 'uavModelNo'] = best.uavModelNo;\n    out[p + 'pilotLon'] = best.pilotLon;\n    out[p + 'pilotLat'] = best.pilotLat;\n    out[p + 'areaFlag'] = best.areaFlag;\n    out[p + 'whiteListId'] = best.whiteListId;\n    out[p + 'targetType'] = best.TargetType;\n    if (best.tsp) { out[p + 'uavTspMs'] = best.tsp; }\n  }\n  if (pos.Tsp) { out[p + 'msgTspMs'] = pos.Tsp; }\n}\n\n// ---- /api/detect：侦测事件 ----\nif (det != null && det.Drones != null) {\n  out[p + 'droneCount'] = det.Drones.length;\n  var bd = null;\n  for (var m = 0; m < det.Drones.length; m++) {\n    if (bd == null || (det.Drones[m].tspMs || 0) > (bd.tspMs || 0)) { bd = det.Drones[m]; }\n  }\n  if (bd != null) {\n    out[p + 'uavId'] = bd.uavId;\n    out[p + 'uavModelText'] = bd.uavModelText;\n    out[p + 'uavModelNo'] = bd.uavModelNo;\n    out[p + 'frequencyHz'] = bd.frequency;\n    out[p + 'bandHz'] = bd.band;\n    out[p + 'rssi'] = bd.rssi;\n    out[p + 'snr'] = bd.snr;\n    out[p + 'papr'] = bd.papr;\n    out[p + 'uavAzimuth'] = bd.uavAzimuth;\n    if (bd.tspMs) { out[p + 'detectTspMs'] = bd.tspMs; }\n    var ud = bd.useDevice;\n    if (ud != null) {\n      out[p + 'sensorId'] = ud.sensorId;\n      out[p + 'sensorLon'] = ud.sensorLongitude;\n      out[p + 'sensorLat'] = ud.sensorLatitude;\n      out[p + 'sensorAlt'] = ud.sensorAltitude;\n    }\n  }\n  if (det.Tsp) { out[p + 'msgTspMs'] = det.Tsp; }\n}\n\nreturn {msg: out, metadata: metadata, msgType: msgType};"
          },
          "additionalInfo": {
            "description": null,
            "layoutX": 149,
            "layoutY": 510
          }
