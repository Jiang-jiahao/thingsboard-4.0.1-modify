        "externalId": null,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "function pick(suffix) {\n  for (var k in msg) {\n    if (k.length > suffix.length && k.slice(-suffix.length) === suffix) return msg[k];\n  }\n  return null;\n}\nfunction gf(n, suffix) { return pick('gf' + n + suffix); }\nvar jamming = 0;\nfor (var i = 1; i <= 6; i++) { if (gf(i, 'PaSwitch') === 1) { jamming = 1; break; } }\nvar body = {\n  station_id: msg.ss_stationId == null ? '' : String(msg.ss_stationId),\n  jammerD: [{\n    id: msg.deviceId == null ? '' : String(msg.deviceId),\n    ip: msg.cs_ip == null ? null : String(msg.cs_ip),\n    link_state: 1,\n    jamming_state: jamming,\n    jamming_mode: 0,\n    jamming_trigger_mode: 0,\n    rtsp_address: null,\n    horizontal_heading_angle: pick('ptzPanDeg'),\n    vertical_heading_angle: pick('ptzTiltDeg'),\n    zoom_level: null,\n    longitude: msg.cs_lon == null ? null : msg.cs_lon,\n    latitude: msg.cs_lat == null ? null : msg.cs_lat,\n    height: msg.cs_height == null ? null : msg.cs_height\n  }]\n};\nreturn { msg: body, metadata: metadata, msgType: msgType };",
          "tbelScript": null
